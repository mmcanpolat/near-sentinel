# Copy to .env. Everything is optional: with no key the app runs in offline command mode.
# Any OpenAI-compatible chat-completions endpoint works (OpenAI, NEAR AI Cloud, OpenRouter, Ollama...).
# A key is REQUIRED for any LLM; leave it empty to stay in offline mode (the default).
LLM_API_KEY=
# NEAR AI Cloud (https://cloud.near.ai, buy credits, create a key): uncomment the next line, then set LLM_API_KEY above.
#   -> base URL https://cloud-api.near.ai/v1, default model zai-org/GLM-5.1-FP8 (must support tool calling)
# LLM_PROVIDER=near-ai
# Any preset can be overridden. Defaults (OpenAI): https://api.openai.com/v1 and gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Optional: override the public NEAR RPC (default: rpc.mainnet.fastnear.com, then rpc.mainnet.near.org)
# NEAR_RPC_URL=
# Optional: NEAR Intents (1Click) JWT; without it quotes still work, the protocol may add its own fee
# NEAR_INTENTS_JWT=

PORT=3000
# HOST=127.0.0.1
