# Copy to .env. Everything is optional: with no key the app runs in offline command mode.
# Any OpenAI-compatible chat-completions endpoint works (OpenAI, NEAR AI Cloud, OpenRouter, Ollama...).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: override the public NEAR RPC (default: rpc.mainnet.fastnear.com, then rpc.mainnet.near.org)
# NEAR_RPC_URL=
# Optional: NEAR Intents (1Click) JWT; without it quotes still work, the protocol may add its own fee
# NEAR_INTENTS_JWT=

PORT=3000
# HOST=127.0.0.1
